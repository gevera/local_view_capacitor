# Copy to `.env` for local Docker Compose / Coolify-style deploys.
# Generate SECRET_KEY_BASE with: mix phx.gen.secret

# --- Required (production / Docker) ---
SECRET_KEY_BASE=
PHX_HOST=your-app.example.com
PHX_SERVER=true
PORT=4000
DATABASE_PATH=/data/local_first.db

# --- Optional ---
POOL_SIZE=5
# DNS_CLUSTER_QUERY=

# Gotify: notify phones when a report is soft-deleted.
# Create an Application in Gotify and paste its token here.
# Leave blank to disable push notifications.
GOTIFY_URL=
GOTIFY_APP_TOKEN=
GOTIFY_PRIORITY=5
